		texture = { file = "ccp7_temple_01_unique_diffuse.dds" index = 5 }
		shader = "snap_to_terrain_atlas"
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "temple_01_LOD_1"
		index = 0
		texture_diffuse = "building_emishi_atlas_diffuse.dds"
		texture_normal = "building_emishi_atlas_normal.dds"
		texture_specular = "building_emishi_atlas_properties.dds"
		texture = { file = "ccp7_temple_01_unique_diffuse.dds" index = 5 }
		shader = "snap_to_terrain_atlas"
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "temple_decal_plane"
		index = 0
		texture_diffuse = "japanese_wall_decal_diffuse.dds"
		texture_normal = "japanese_wall_decal_normal.dds"
		texture_specular = "japanese_wall_decal_properties.dds"
		shader = "decal_local"
		shader_file = "gfx/FX/pdxmesh_decal.shader"
		subpass = "LocalDecals"
	}

}

